# Jeton API Pipedrive : Pipedrive > Paramètres personnels > API (Préférences personnelles)
PIPEDRIVE_API_TOKEN=

# Sous-domaine de votre compte Pipedrive (https://<domaine>.pipedrive.com)
PIPEDRIVE_COMPANY_DOMAIN=alphasudassurance

# Port HTTP de l'application
PORT=3000

# Mettre à 1 pour utiliser des données fictives (sans jeton Pipedrive)
DEMO_MODE=0

# Intervalle de synchronisation automatique en secondes (min 30)
SYNC_INTERVAL=60

# Objectif mensuel de primes signées (affiché dans le cabinet virtuel)
MONTHLY_TARGET=10000
